--- 
import{resolveLocale, t, type Locale} from '@/lib/i18n';

const { class: className } = Astro.props;
const year = new Date().getFullYear().toString();
const lang = resolveLocale(Astro.currentLocale as Locale | undefined);
const copyright = t('Headercopyright', { year }, lang);
---
<footer class:list={["border-t border-border py-6 text-center text-sm text-muted-foreground", className]}>
  <div class="container mx-auto px-4">
    <p>{copyright}</p>
  </div>
</footer>
