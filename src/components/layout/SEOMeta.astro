---
import { author as siteAuthor } from '@/data/author';
import { getLocalizedAlternates, getLocaleFromPathname, stripLocaleFromPathname, type Locale } from '@/lib/i18n';
import { siteSchemas } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
  author?: string;
  alternateLocales?: Locale[];
  articleSection?: string;
  articleTitle?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  updatedTime,
  tags = [],
  author = siteAuthor.name,
  alternateLocales = ['en', 'zh'],
  articleSection,
  articleTitle,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || siteAuthor.site.url;
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname.replace(/\/+$/, '') || '/', siteUrl).toString();
const locale = getLocaleFromPathname(pathname);
const unlocalizedPathname = stripLocaleFromPathname(pathname);
const alternates = getLocalizedAlternates(unlocalizedPathname);

// Generate OG image URL from slug if not provided
// For blog posts (/blog/slug/), we want /og/slug.png
// For index (/), we want /og/index.png
function getOgImagePath(pathname: string): string {
  if (pathname === '/' || pathname === '') {
    return '/og/index.png';
  }
  // Extract the last meaningful segment (e.g., /blog/welcome/ -> welcome)
  const segments = pathname.split('/').filter(Boolean);
  const slug = segments[segments.length - 1];
  if (/^\/(?:zh\/)?(?:blog|stories)\//.test(pathname)) {
    return `/og/${segments.join('/')}.png`;
  }
  return '/og/index.png';
}

const ogImageUrl = image
  ? new URL(image, siteUrl).toString()
  : `${siteUrl}${getOgImagePath(Astro.url.pathname)}`;

const pageSchemas = type === 'article'
  ? [
      {
        '@context': 'https://schema.org',
        '@type': articleSection === 'Stories' ? 'Article' : 'BlogPosting',
        '@id': `${canonicalUrl}#article`,
        headline: articleTitle ?? title,
        description,
        image: [ogImageUrl],
        url: canonicalUrl,
        mainEntityOfPage: canonicalUrl,
        author: {
          '@id': `${siteUrl}/#person`,
        },
        publisher: {
          '@id': `${siteUrl}/#person`,
        },
        datePublished: publishedTime?.toISOString(),
        dateModified: (updatedTime ?? publishedTime)?.toISOString(),
        articleSection,
        keywords: tags.join(', '),
        inLanguage: locale === 'zh' ? 'zh-CN' : 'en-US',
        isPartOf: { '@id': `${siteUrl}/#website` },
      },
    ]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${canonicalUrl}#webpage`,
        name: title,
        description,
        url: canonicalUrl,
        inLanguage: locale === 'zh' ? 'zh-CN' : 'en-US',
        isPartOf: { '@id': `${siteUrl}/#website` },
      },
    ];
---

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
<meta name="author" content={author} />
<meta name="theme-color" content="#0a0a0a" />

{
  alternateLocales.map((alternateLocale) => (
    <link
      rel="alternate"
      hreflang={alternateLocale === 'zh' ? 'zh-CN' : 'en'}
      href={new URL(alternates[alternateLocale], siteUrl).toString()}
    />
  ))
}
{alternateLocales.includes('en') && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, siteUrl).toString()} />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={articleTitle ?? title} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteAuthor.site.name} />
<meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
{
  alternateLocales
    .filter((alternateLocale) => alternateLocale !== locale)
    .map((alternateLocale) => (
      <meta property="og:locale:alternate" content={alternateLocale === 'zh' ? 'zh_CN' : 'en_US'} />
    ))
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={articleTitle ?? title} />
<meta name="twitter:site" content={siteAuthor.social.x.handle} />
<meta name="twitter:creator" content={siteAuthor.social.x.handle} />

<!-- Article-specific meta tags -->
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )
}
{type === 'article' && updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
{type === 'article' && articleSection && <meta property="article:section" content={articleSection} />}

<script type="application/ld+json" set:html={JSON.stringify(siteSchemas.person).replaceAll('<', '\\u003c')} />
<script type="application/ld+json" set:html={JSON.stringify(siteSchemas.website).replaceAll('<', '\\u003c')} />
{pageSchemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />)}
