---
import { cn } from '@/lib/utils';

export interface PropItem {
  /** 属性名 */
  prop: string;
  /** 类型定义 (如 string, boolean, union 等) */
  type: string;
  /** 默认值 */
  default?: string;
  /** 属性功能与用法说明 */
  description: string;
  /** 是否必填 */
  required?: boolean;
}

interface Props {
  /** 属性列表数组 */
  items: PropItem[];
  /** 自定义标题，默认 'Props & API Reference' */
  title?: string;
  /** 自定义描述/提示文本 */
  description?: string;
  /** 主题色调，用于高亮属性名 (sky | emerald | amber | purple) */
  color?: 'sky' | 'emerald' | 'amber' | 'purple';
  /** 自定义外层类名 */
  className?: string;
}

const {
  items,
  title = 'Props & API Reference',
  description,
  color = 'sky',
  className,
} = Astro.props;

const colorMap = {
  sky: 'text-sky-600 dark:text-sky-400',
  emerald: 'text-emerald-600 dark:text-emerald-400',
  amber: 'text-amber-600 dark:text-amber-400',
  purple: 'text-purple-600 dark:text-purple-400',
};

const iconColorMap = {
  sky: 'text-sky-400',
  emerald: 'text-emerald-400',
  amber: 'text-amber-400',
  purple: 'text-purple-400',
};
---

<section class={cn("space-y-4", className)}>
  <div class="border-b border-border/60 pb-3">
    <h2 class="text-xl font-bold tracking-tight text-foreground flex items-center gap-2">
      <span class={iconColorMap[color]}>⚡</span>
      <span>{title}</span>
    </h2>
    {description && (
      <p class="text-xs text-muted-foreground mt-1 leading-relaxed">
        {description}
      </p>
    )}
  </div>

  <div class="overflow-x-auto rounded-2xl border border-border/70 bg-card/40 backdrop-blur-xl shadow-sm">
    <table class="w-full text-left text-xs border-collapse font-mono">
      <thead>
        <tr class="border-b border-border/60 text-muted-foreground uppercase tracking-wider bg-muted/20 select-none">
          <th class="py-3 px-4 w-[22%]">Prop</th>
          <th class="py-3 px-4 w-[36%]">Type</th>
          <th class="py-3 px-4 w-[14%]">Default</th>
          <th class="py-3 px-4 w-[28%] font-sans">Description</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/40 text-foreground/90">
        {items.map((item) => (
          <tr class="hover:bg-muted/30 transition-colors">
            {/* Prop Name */}
            <td class="py-3 px-4 align-top">
              <div class="flex items-center gap-1.5 flex-wrap">
                <code class={cn("font-bold text-xs", colorMap[color])}>
                  {item.prop}
                </code>
                {item.required && (
                  <span class="text-[9px] font-mono px-1 py-0.2 rounded bg-rose-500/15 text-rose-500 border border-rose-500/30">
                    Required
                  </span>
                )}
              </div>
            </td>

            {/* Type */}
            <td class="py-3 px-4 align-top">
              <span class="text-[11px] font-mono text-muted-foreground/90 break-words leading-relaxed">
                {item.type}
              </span>
            </td>

            {/* Default */}
            <td class="py-3 px-4 align-top">
              {item.default ? (
                <code class="text-[11px] font-mono text-amber-600 dark:text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/20">
                  {item.default}
                </code>
              ) : (
                <span class="text-muted-foreground/50 text-xs">-</span>
              )}
            </td>

            {/* Description */}
            <td class="py-3 px-4 align-top font-sans text-xs text-muted-foreground leading-relaxed">
              {item.description}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
