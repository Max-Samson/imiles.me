---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import { resolveContentPublicPath } from '@/lib/content-routing';
import { getServerEnv } from '@/server/env';
import { contentReadRepository } from '@/server/content/read-repository';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const env = getServerEnv(Astro.locals);
const postRepo = contentReadRepository(env);

const d1Post = await postRepo.findByPath(pathname);

let storyData: {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  body: string;
  contentHtml?: string;
};
let ContentComponent: any = null;
let alternateLocales: Array<'en' | 'zh'> = ['zh'];

if (d1Post) {
  storyData = {
    title: d1Post.title,
    description: d1Post.description ?? '',
    pubDate: new Date(d1Post.pubDate),
    updatedDate: d1Post.updatedDate ? new Date(d1Post.updatedDate) : undefined,
    tags: (() => {
      try {
        return JSON.parse(d1Post.tags);
      } catch {
        return [];
      }
    })(),
    body: d1Post.contentRaw,
    contentHtml: d1Post.contentHtml,
  };
} else {
  const stories = await getCollection('stories', ({ data }) => data.draft !== true);
  const matched = stories.find((s) => resolveContentPublicPath('stories', 'zh', s.id) === pathname);
  if (!matched) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  const rendered = await render(matched);
  ContentComponent = rendered.Content;
  storyData = {
    title: matched.data.title,
    description: matched.data.description,
    pubDate: matched.data.pubDate,
    updatedDate: matched.data.updatedDate,
    tags: matched.data.tags,
    body: matched.body ?? '',
  };
}

const readTime = calculateReadTime(storyData.body);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://imiles.me';
const storyUrl = `${siteUrl}${pathname}`;
const slug = pathname.slice('/zh/stories/'.length);

const etag = `W/"${d1Post?.sourceHash ?? 'static'}"`;
if (Astro.request.headers.get('if-none-match') === etag) {
  return new Response(null, {
    status: 304,
    headers: {
      'ETag': etag,
      'Cache-Control': 'public, max-age=60, s-maxage=300, stale-while-revalidate=1800',
    },
  });
}

Astro.response.headers.set('ETag', etag);
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=1800',
);
---

<BaseLayout
  title={`${storyData.title} - Miles`}
  description={storyData.description}
  ogType="article"
  publishedTime={storyData.pubDate}
  updatedTime={storyData.updatedDate}
  alternateLocales={alternateLocales}
  articleSection="Stories"
  articleTitle={storyData.title}
  tags={storyData.tags}
>
  <ArticleLayout
    title={storyData.title}
    pubDate={storyData.pubDate}
    updatedDate={storyData.updatedDate}
    readTime={readTime.text}
    tags={storyData.tags}
    shareUrl={storyUrl}
    body={storyData.body}
    frontmatter={{
      title: storyData.title,
      description: storyData.description,
      pubDate: storyData.pubDate.toISOString().split('T')[0],
      tags: storyData.tags,
    }}
    slug={slug}
    proseClass="story-prose prose-lg"
    backHref="/zh/stories"
    backLabel="content/stories"
  >
    {storyData.contentHtml ? (
      <div set:html={storyData.contentHtml} />
    ) : (
      ContentComponent && <ContentComponent />
    )}

    <footer slot="after-content" class="story-end">
      <div class="story-end-ornament" aria-hidden="true">
        <span class="story-end-line"></span>
        <span class="story-end-diamond"></span>
        <span class="story-end-line"></span>
      </div>
      <p class="story-end-label">End</p>
    </footer>
  </ArticleLayout>

  <style is:global>
    .story-prose {
      font-size: 1.2rem;
      line-height: 2;
      letter-spacing: 0.01em;
    }

    .story-prose p {
      margin-top: 0.5em;
      margin-bottom: 0.5em;
    }

    .story-prose hr {
      border: none;
      border-top: none;
      background: none;
      height: auto;
      text-align: center;
      margin: 3rem auto;
      overflow: visible;
    }

    .story-prose hr::after {
      content: '—\2009\2009\2009\2727\2009\2009\2009—';
      display: block;
      color: var(--color-muted-foreground);
      font-size: 0.875rem;
      letter-spacing: 0.15em;
    }

    .story-prose em {
      font-style: italic;
    }

    .story-prose strong {
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .story-end {
      margin-top: 4rem;
      padding-top: 2rem;
      text-align: center;
    }

    .story-end-ornament {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .story-end-line {
      display: block;
      width: 4rem;
      height: 1px;
      background: var(--color-muted-foreground);
      opacity: 0.3;
    }

    .story-end-diamond {
      display: block;
      width: 6px;
      height: 6px;
      background: var(--color-muted-foreground);
      transform: rotate(45deg);
      opacity: 0.5;
    }

    .story-end-label {
      font-size: 0.8rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      color: var(--color-muted-foreground);
      opacity: 0.6;
    }
  </style>
</BaseLayout>
