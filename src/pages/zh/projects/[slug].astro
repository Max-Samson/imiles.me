---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentLightRaysBackground from '@/components/layout/ContentLightRaysBackground';
import ProjectHero from '@/components/project/ProjectHero';
import TerminalDemo from '@/components/common/TerminalDemo';
import ImageShowcase from '@/components/common/ImageShowcase';
import LiveComponentDemo from '@/components/common/LiveComponentDemo';
import FeatureGrid from '@/components/common/FeatureGrid';
import TechStackGrid from '@/components/common/TechStackGrid';
import { projects, getProject } from '@/data/projects';
import { localizePathname, resolveLocale, useTranslations, type Locale } from '@/lib/i18n';
const lang = resolveLocale(Astro.currentLocale as Locale | undefined);
const { t } = useTranslations(lang);
export function getStaticPaths() {
  return projects
    .filter((p) => p.hasDetailPage)
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug!, lang);

if (!project) {
  return Astro.redirect(localizePathname(`/${lang}/projects`, lang));
}
---

<BaseLayout title={`${project.title} - Miles`} description={project.tagline}>
  <main class="relative isolate min-h-screen overflow-x-clip pb-16">
    <ContentLightRaysBackground client:only="react" />

    <ProjectHero
      project={project}
      lang={lang}
      backHref={localizePathname('/projects', lang)}
      backLabel="src/projects"
      client:load
    />

    <section class="container mx-auto px-4 py-12">
      <h2 class="mb-4 text-2xl font-bold">{t('NoteSectionOneTitle')}</h2>
      <p class="max-w-3xl text-muted-foreground leading-relaxed">
        {project.description}
      </p>
    </section>

    {project.demo?.kind === 'terminal' && <TerminalDemo title={project.demo.title} lines={project.demo.lines} client:visible />}
    {project.demo?.kind === 'image' && <ImageShowcase images={project.demo.images} title={t('ProjectDetailsTitle')} client:visible />}
    {project.demo?.kind === 'live' && <LiveComponentDemo componentSlug={project.demo.componentSlug} client:visible />}

    <FeatureGrid features={project.features} lang={lang} className={project.demo?.kind === 'image' ? 'pt-4 lg:pt-6' : undefined} client:visible />
    <TechStackGrid tech={project.tech} lang={lang} client:visible />
  </main>
</BaseLayout>
