---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentLightRaysBackground from '@/components/layout/ContentLightRaysBackground';
import NoteHero from '@/components/note/NoteHero';
import MarqueeImage from '@/components/note/MarqueeImage';
import FeatureGrid from '@/components/common/FeatureGrid';
import TechStackGrid from '@/components/common/TechStackGrid';
import { research, getResearchItem } from '@/data/notes';
import { localizePathname, resolveLocale, useTranslations, type Locale } from '@/lib/i18n';
const lang = resolveLocale(Astro.currentLocale as Locale | undefined);
const { t } = useTranslations(lang);
export function getStaticPaths() {
  return research
    .filter((r) => r.hasDetailPage)
    .map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const item = getResearchItem(slug!);

if (!item) {
  return Astro.redirect(localizePathname(`/${lang}/notes`, lang));
}
---

<BaseLayout title={`${item.title} - Miles`} description={item.tagline}>
  <main class="relative isolate min-h-screen overflow-hidden pb-16">
    <ContentLightRaysBackground client:only="react" />

    <div class="relative z-10">
      <NoteHero item={item} client:load />
  
      <section class="container mx-auto px-4 py-12">
        <h2 class="mb-4 text-2xl font-bold tracking-tight">{t('NoteSectionOneTitle')}</h2>
        <p class="max-w-3xl leading-relaxed text-muted-foreground/90">
          {item.description}
        </p>
      </section>
  
      {item.demo?.kind === 'image' && <MarqueeImage images={item.demo.images} lang={lang} client:visible />}
      {item.features && <FeatureGrid features={item.features} lang={lang} client:visible />}
      {item.detailTech && <TechStackGrid tech={item.detailTech} lang={lang} client:visible />}
    </div>
  </main>
</BaseLayout>
