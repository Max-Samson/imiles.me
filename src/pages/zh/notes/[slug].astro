---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteHero from '@/components/note/NoteHero';
import MarqueeImage from '@/components/note/MarqueeImage';
import FeatureGrid from '@/components/FeatureGrid';
import TechStackGrid from '@/components/TechStackGrid';
import { research, getResearchItem } from '@/data/research';
import { localizePathname, resolveLocale, useTranslations, type Locale } from '@/lib/i18n';
const lang = resolveLocale(Astro.currentLocale as Locale | undefined);
const { t } = useTranslations(lang);
export function getStaticPaths() {
  return research
    .filter((r) => r.hasDetailPage)
    .map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const item = getResearchItem(slug!);

if (!item) {
  return Astro.redirect(localizePathname(`/${lang}/notes`, lang));
}
---

<BaseLayout title={`${item.title} - Miles`} description={item.tagline}>
  <main class="relative min-h-screen pb-16 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute inset-0 bg-[#fafafa] dark:bg-[#080808] transition-colors duration-1000"></div>
  
      <div class="animate-float absolute -top-[15%] -right-[10%] h-[80vh] w-[80vw] rounded-full 
                  bg-gradient-to-br from-gray-300/40 to-transparent blur-[130px] 
                  dark:from-white/[0.08] dark:to-transparent 
                  will-change-transform"></div>
  
      <div class="animate-float-delayed absolute -bottom-[15%] -left-[10%] h-[70vh] w-[70vw] rounded-full 
                  bg-gradient-to-tr from-gray-200/30 to-transparent blur-[100px] 
                  dark:from-white/[0.04] dark:to-transparent 
                  will-change-transform"></div>
  
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] 
                  bg-[size:40px_40px] 
                  [mask-image:radial-gradient(ellipse_80%_80%_at_50%_40%,#000_20%,transparent_100%)]">
      </div>
  
      <div class="absolute inset-0 opacity-[0.02] dark:opacity-[0.04] mix-blend-overlay" 
           style="background-image: url('data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noise\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.9\' numOctaves=\'4\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noise)\'/%3E%3C/svg%3E');">
      </div>
    </div>
  
    <div class="relative z-10">
      <NoteHero item={item} client:load />
  
      <section class="container mx-auto px-4 py-12">
        <h2 class="mb-4 text-2xl font-bold tracking-tight">{t('NoteSectionOneTitle')}</h2>
        <p class="max-w-3xl leading-relaxed text-muted-foreground/90">
          {item.description}
        </p>
      </section>
  
      {item.demo?.kind === 'image' && <MarqueeImage images={item.demo.images} lang={lang} client:visible />}
      {item.features && <FeatureGrid features={item.features} lang={lang} client:visible />}
      {item.detailTech && <TechStackGrid tech={item.detailTech} lang={lang} client:visible />}
    </div>
  </main>
</BaseLayout>
