---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import { resolveContentPublicPath } from '@/lib/content-routing';
import CodeBlockEnhancer from '@/components/article/CodeBlockEnhancer';
import HeadingLinkEnhancer from '@/components/article/HeadingLinkEnhancer';
import MobileTOC from '@/components/article/MobileTOC';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  const ids = new Set(posts.filter((post) => post.data.lang === 'en').map((post) => post.id));
  return posts.filter((post) => post.data.lang === 'zh').map((post) => ({
    params: { slug: resolveContentPublicPath('blog', 'zh', post.id).slice('/zh/blog/'.length) },
    props: { post, alternateLocales: ids.has(post.id.replace(/-zh$/, '')) ? (['en', 'zh'] as Array<'en' | 'zh'>) : (['zh'] as Array<'en' | 'zh'>) },
  }));
}

const { post, alternateLocales } = Astro.props;
const { Content, headings } = await render(post);
const readTime = calculateReadTime(post.body || '');

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://imiles.me';
const slug = resolveContentPublicPath('blog', 'zh', post.id).slice('/zh/blog/'.length);
const postUrl = `${siteUrl}${resolveContentPublicPath('blog', 'zh', post.id)}`;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showTOC = tocHeadings.length >= 3;
---

<BaseLayout
  title={`${post.data.title} | Miles`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
  ogImage={post.data.heroImage}
  alternateLocales={alternateLocales}
  tags={post.data.tags}
  articleSection="Blog"
  articleTitle={post.data.title}
  loadKatex
>
  <ArticleLayout
    title={post.data.title}
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    readTime={readTime.text}
    tags={post.data.tags}
    shareUrl={postUrl}
    shareText={post.data.shareText}
    body={post.body ?? ''}
    frontmatter={{
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate.toISOString().split('T')[0],
      updatedDate: post.data.updatedDate?.toISOString().split('T')[0],
      heroImage: post.data.heroImage,
      tags: post.data.tags,
    }}
    slug={slug}
  >
    {showTOC && (
      <div slot="before-content">
        <MobileTOC client:load headings={tocHeadings} />
      </div>
    )}

    <Content />

    <Fragment slot="enhancers">
      <CodeBlockEnhancer client:idle />
      <HeadingLinkEnhancer client:load />
    </Fragment>
  </ArticleLayout>
</BaseLayout>
