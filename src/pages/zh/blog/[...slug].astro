---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import { resolveContentPublicPath } from '@/lib/content-routing';
import { getServerEnv } from '@/server/env';
import { contentReadRepository } from '@/server/content/read-repository';
import { extractHeadingsFromHtml } from '@/lib/content-headings';
import CodeBlockEnhancer from '@/components/article/CodeBlockEnhancer';
import HeadingLinkEnhancer from '@/components/article/HeadingLinkEnhancer';
import MobileTOC from '@/components/article/MobileTOC';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const env = getServerEnv(Astro.locals);
const postRepo = contentReadRepository(env);

// 1. 优先从 D1 数据库查询已发布文章
const d1Post = await postRepo.findByPath(pathname);

// 2. 检索是否有同路径的静态 Content Collection 文章
const staticPosts = await getCollection('blog');
const matchedStatic = staticPosts.find((p) => resolveContentPublicPath('blog', 'zh', p.id) === pathname);

if (!d1Post && !matchedStatic) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let postData: {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags: string[];
  shareText?: string;
  body: string;
  contentHtml?: string;
};
let tocHeadings: Array<{ depth: number; slug: string; text: string }> = [];
let ContentComponent: any = null;
let alternateLocales: Array<'en' | 'zh'> = ['zh'];
const alternatePath = pathname.replace(/^\/zh\/blog\//, '/blog/');
if (
  staticPosts.some((post) => post.data.lang === 'en' && resolveContentPublicPath('blog', 'en', post.id) === alternatePath) ||
  (await postRepo.findByPath(alternatePath))
) {
  alternateLocales = ['en', 'zh'];
}

// 若静态存在且与 D1 源码相同（或属于 MDX 构建产物），优先使用完整的 Astro MDX 组件渲染流水线
if (matchedStatic && (!d1Post || (d1Post.format === 'mdx' && d1Post.contentRaw === (matchedStatic.body ?? '')))) {
  const rendered = await render(matchedStatic);
  ContentComponent = rendered.Content;
  tocHeadings = rendered.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
  postData = {
    title: d1Post?.title ?? matchedStatic.data.title,
    description: d1Post?.description ?? matchedStatic.data.description,
    pubDate: d1Post ? new Date(d1Post.pubDate) : matchedStatic.data.pubDate,
    updatedDate: d1Post ? new Date(d1Post.updatedDate ?? d1Post.updatedAt) : matchedStatic.data.updatedDate,
    heroImage: d1Post?.heroImage ?? matchedStatic.data.heroImage,
    tags: d1Post
      ? (() => {
          try {
            return JSON.parse(d1Post.tags);
          } catch {
            return [];
          }
        })()
      : matchedStatic.data.tags,
    shareText: d1Post?.shareText ?? matchedStatic.data.shareText,
    body: matchedStatic.body ?? '',
  };
} else if (d1Post) {
  postData = {
    title: d1Post.title,
    description: d1Post.description ?? '',
    pubDate: new Date(d1Post.pubDate),
    updatedDate: new Date(d1Post.updatedDate ?? d1Post.updatedAt),
    heroImage: d1Post.heroImage ?? undefined,
    tags: (() => {
      try {
        return JSON.parse(d1Post.tags);
      } catch {
        return [];
      }
    })(),
    shareText: d1Post.shareText ?? undefined,
    body: d1Post.contentRaw,
    contentHtml: d1Post.contentHtml,
  };
  tocHeadings = extractHeadingsFromHtml(d1Post.contentHtml);
} else {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const readTime = calculateReadTime(postData.body);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://imiles.me';
const postUrl = `${siteUrl}${pathname}`;
const showTOC = tocHeadings.length >= 3;
const slug = pathname.slice('/zh/blog/'.length);

const etag = `W/"${d1Post?.sourceHash ?? 'static'}"`;
if (Astro.request.headers.get('if-none-match') === etag) {
  return new Response(null, {
    status: 304,
    headers: {
      'ETag': etag,
      'Cache-Control': 'public, max-age=60, s-maxage=300, stale-while-revalidate=1800',
    },
  });
}

Astro.response.headers.set('ETag', etag);
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=1800',
);
---

<BaseLayout
  title={`${postData.title} | Miles`}
  description={postData.description}
  ogImage={postData.heroImage}
  ogType="article"
  publishedTime={postData.pubDate}
  updatedTime={postData.updatedDate}
  alternateLocales={alternateLocales}
  tags={postData.tags}
  articleSection="Blog"
  articleTitle={postData.title}
>
  <ArticleLayout
    title={postData.title}
    pubDate={postData.pubDate}
    updatedDate={postData.updatedDate}
    readTime={readTime.text}
    tags={postData.tags}
    shareUrl={postUrl}
    body={postData.body}
    frontmatter={{
      title: postData.title,
      description: postData.description,
      pubDate: postData.pubDate.toISOString().split('T')[0],
      heroImage: postData.heroImage,
      tags: postData.tags,
    }}
    slug={slug}
    backHref="/zh/blog"
    backLabel="content/blog"
  >
    {showTOC && (
      <div slot="before-content">
        <MobileTOC client:load headings={tocHeadings} />
      </div>
    )}

    {ContentComponent ? (
      <ContentComponent />
    ) : postData.contentHtml ? (
      <div set:html={postData.contentHtml} />
    ) : null}
  </ArticleLayout>

  <CodeBlockEnhancer client:load />
  <HeadingLinkEnhancer client:load />
</BaseLayout>
