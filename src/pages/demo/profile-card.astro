---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfileCard from '@/components/common/ProfileCardMiles';
import BackButton from '@/components/common/BackButton';
import ContentLightRaysBackground from '@/components/layout/ContentLightRaysBackground';

const codeSnippet = `import ProfileCard from './ProfileCard';

<ProfileCard
  name="Javi A. Torres"
  title="Software Engineer"
  handle="javicodes"
  status="Online"
  contactText="Contact Me"
  avatarUrl="/path/to/avatar.jpg"
  showUserInfo
  enableTilt={true}
  enableMobileTilt
  onContactClick={() => console.log('Contact clicked')}
  behindGlowColor="rgba(125, 190, 255, 0.67)"
  iconUrl="/assets/demo/iconpattern.png"
  behindGlowEnabled
  innerGradient="linear-gradient(145deg,#60496e8c 0%,#71C4FF44 100%)"
/>`;
---

<BaseLayout
  title="ProfileCard Demo | React Bits"
  description="Interactive 3D holographic tilt profile card demo using React Bits and Tailwind CSS."
>
  <div class="relative min-h-screen isolate overflow-hidden bg-background py-16 px-4 sm:px-8">
    {/* Ambient light backdrop */}
    <div class="pointer-events-none absolute inset-0 z-0 opacity-40">
      <ContentLightRaysBackground client:idle className="absolute!" />
    </div>

    <div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center">
      {/* Top navigation */}
      <div class="w-full flex items-center justify-between mb-8">
        <BackButton href="/" label="Home" className="mb-0" />
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse" />
          <span>React Bits Component</span>
        </div>
      </div>

      {/* Page Heading */}
      <header class="text-center mb-8">
        <p class="text-xs uppercase tracking-widest text-muted-foreground mb-2">Interactive Showcase</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground">ProfileCard</h1>
        <p class="mt-2 text-sm text-muted-foreground max-w-md mx-auto text-balance">
          Holographic foil effect, 3D physics tilt engine, behind ambient glow, and mobile gyroscope support.
        </p>
      </header>

      {/* Live interactive Demo */}
      <div class="w-full flex justify-center items-center py-4">
        <ProfileCard
          client:load
          name="Javi A. Torres"
          title="Software Engineer"
          handle="javicodes"
          status="Online"
          contactText="Contact Me"
          avatarUrl="/images/avatar.png"
          showUserInfo={true}
          enableTilt={true}
          enableMobileTilt={true}
          behindGlowColor="rgba(125, 190, 255, 0.67)"
          iconUrl="/assets/demo/iconpattern.png"
          behindGlowEnabled={true}
          innerGradient="linear-gradient(145deg,#60496e8c 0%,#71C4FF44 100%)"
        />
      </div>

      {/* Code & Props Section */}
      <div class="w-full max-w-2xl mt-16 rounded-2xl border border-border/80 bg-card/60 backdrop-blur-xl p-6 shadow-2xl">
        <div class="flex items-center justify-between mb-4 border-b border-border/60 pb-3">
          <h2 class="text-sm font-semibold text-foreground flex items-center gap-2">
            <span class="text-sky-400">⚡</span> Component Usage
          </h2>
          <span class="text-xs text-muted-foreground font-mono">ProfileCard.tsx</span>
        </div>

        <pre class="overflow-x-auto rounded-xl bg-black/70 p-4 text-xs font-mono text-white/90 leading-relaxed border border-white/5"><code>{codeSnippet}</code></pre>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 pt-4 border-t border-border/40 text-center">
          <div class="p-2 rounded-lg bg-muted/30">
            <p class="text-[10px] uppercase text-muted-foreground">Physics Engine</p>
            <p class="text-xs font-semibold text-foreground mt-0.5">3D Tilt & Damping</p>
          </div>
          <div class="p-2 rounded-lg bg-muted/30">
            <p class="text-[10px] uppercase text-muted-foreground">Shading</p>
            <p class="text-xs font-semibold text-foreground mt-0.5">Holo Foil Mask</p>
          </div>
          <div class="p-2 rounded-lg bg-muted/30">
            <p class="text-[10px] uppercase text-muted-foreground">Glow Effect</p>
            <p class="text-xs font-semibold text-foreground mt-0.5">Radial Pointer Blur</p>
          </div>
          <div class="p-2 rounded-lg bg-muted/30">
            <p class="text-[10px] uppercase text-muted-foreground">Mobile</p>
            <p class="text-xs font-semibold text-foreground mt-0.5">Gyroscope Device</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
