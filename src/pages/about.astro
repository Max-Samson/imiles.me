---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutHero from '@/components/about/AboutHero';
import ContentFlickeringBackground from '@/components/layout/ContentFlickeringBackground';
import { getLocaleFromPathname, useTranslations } from '@/lib/i18n';

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
const introduction = await getEntry('blog', lang === 'zh' ? 'miles-zh' : 'miles');
if (!introduction) throw new Error(`Missing About introduction for locale: ${lang}`);
const { Content } = await render(introduction);
---

<BaseLayout
  title={t('PageAboutTitle', { site: 'Miles' })}
  description={t('PageAboutDescription')}
>
  <div class="relative min-h-screen isolate overflow-hidden">
    <ContentFlickeringBackground client:only="react" />

    <div class="relative z-10">
      <AboutHero client:visible lang={lang}>
        <Content />
      </AboutHero>
    </div>
  </div>
</BaseLayout>
