---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/project/ProjectCard';
import { getProjects } from '@/data/projects';
import ContentFlickeringBackground from '@/components/layout/ContentFlickeringBackground';
import { getLocaleFromPathname, useTranslations } from '@/lib/i18n';
const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
const projects = getProjects(lang);
---

<BaseLayout
  title={t('PageProjectsTitle', { site: 'Miles' })}
  description={t('PageProjectsDescription')}
>
  <div class="relative min-h-screen isolate overflow-hidden">
    <ContentFlickeringBackground client:only="react" />

    <main class="container mx-auto px-4 pt-24 pb-16 relative z-10">
      <h1 class="mb-2 text-4xl font-bold tracking-tight text-foreground/90">{t('Headerprojects')}</h1>
      <p class="mb-10 max-w-2xl text-muted-foreground">{t('PageProjectsDescription')}</p>

      <div class="grid gap-6">
        {projects.map((project, i) => (
          <ProjectCard project={project} index={i} client:visible />
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
