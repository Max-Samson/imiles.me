---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import {
  useTranslations,
  getLocaleFromPathname,
  formatDate,
  localizePathname,
} from '@/lib/i18n';

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t('PageblogTitle', { site: 'Miles' })}>
  <main class="container mx-auto px-4 pt-24 pb-16">
    <h1 class="mb-8 text-4xl font-bold">{t('Headerblog')}</h1>
    <div class="flex flex-col gap-6">
      {
        sortedPosts.map((post) => (
          <article class="group">
            <a
              href={localizePathname(`/blog/${post.id}`, lang)}
              class="block rounded-lg border border-border p-6 transition-all duration-300 ease-out hover:border-primary hover:scale-[0.98]"
            >
              <h2 class="text-xl font-semibold text-foreground group-hover:underline">
                {post.data.title}
              </h2>
              <p class="mt-2 text-muted-foreground">{post.data.description}</p>
              <div class="mt-2 flex flex-col gap-1 text-sm text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
                <time>{formatDate(post.data.pubDate, lang)}</time>
                <span class="hidden sm:inline">|</span>
                <span>{calculateReadTime(post.body || '').text}</span>
              </div>
              {
                post.data.updatedDate && (
                  <div class="mt-1 text-xs text-muted-foreground/70">
                    {t('Labelupdated')}: <time>{formatDate(post.data.updatedDate, lang)}</time>
                  </div>
                )
              }
            </a>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
