---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import { ExternalLink, NotebookPen } from 'lucide-react';
import { getBlogNoteLink } from '@/data/blogLinks';
import ContentFlickeringBackground from '@/components/layout/ContentFlickeringBackground';
import { ShineBorder } from '@/registry/magicui/shine-border';
import {
  useTranslations,
  getLocaleFromPathname,
  formatDate,
  localizePathname,
} from '@/lib/i18n';

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
const posts = await getCollection('blog', ({ data }) => data.draft !== true && data.lang === lang);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={t('PageblogTitle', { site: 'Miles' })}
  description={t('PageBlogDescription')}
>
  <div class="relative min-h-screen isolate overflow-hidden">
    <ContentFlickeringBackground client:only="react" />

    <main class="container mx-auto px-4 pt-24 pb-16 relative z-10">
      <h1 class="mb-2 text-4xl font-bold tracking-tight text-foreground/90">{t('Headerblog')}</h1>
      <p class="mb-8 max-w-2xl text-muted-foreground">{t('PageBlogDescription')}</p>
      <div class="flex flex-col gap-6">
      {
        sortedPosts.map((post) => {
          const noteLink = getBlogNoteLink(post.id);

          return (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-white/5 dark:bg-black/5 backdrop-blur-md p-6 transition-all duration-300 ease-out hover:scale-[0.98] hover:border-primary/50">
              <ShineBorder
                client:load
                className="rounded-lg opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                shineColor={["#A07CFE", "#FE8FB5", "#FFBE7B"]}
              />
              <div class="relative z-10 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <a
                  href={localizePathname(`/blog/${post.id}`, lang)}
                  class="block min-w-0 flex-1"
                >
                  <h2 class="text-xl font-semibold text-foreground group-hover:underline">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-muted-foreground">{post.data.description}</p>
                  <div class="mt-2 flex flex-col gap-1 text-sm text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
                    <time>{formatDate(post.data.pubDate, lang)}</time>
                    <span class="hidden sm:inline">|</span>
                    <span>{calculateReadTime(post.body || '').text}</span>
                  </div>
                  {
                    post.data.updatedDate && (
                      <div class="mt-1 text-xs text-muted-foreground/70">
                        {t('Labelupdated')}: <time>{formatDate(post.data.updatedDate, lang)}</time>
                      </div>
                    )
                  }
                </a>
                {
                  noteLink && (
                    <a
                      href={noteLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${post.data.title} ${t('NoteLink')}`}
                      class="inline-flex w-full items-center justify-center gap-1.5 rounded-full border border-border bg-background/70 px-3 py-2 text-xs font-medium text-muted-foreground backdrop-blur-sm transition-colors hover:text-foreground sm:mt-1 sm:w-auto sm:shrink-0 sm:justify-start sm:px-3 sm:py-1.5"
                    >
                      <NotebookPen className="h-3.5 w-3.5" />
                      {t('NoteLink')}
                      <ExternalLink className="h-3 w-3" />
                    </a>
                  )
                }
              </div>
          </article>
        )})
      }
    </div>
  </main>
  </div>
</BaseLayout>
