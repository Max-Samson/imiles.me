---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import { LightRays } from '@/registry/magicui/light-rays';
import { ShineBorder } from '@/registry/magicui/shine-border';
import {
  useTranslations,
  getLocaleFromPathname,
  formatDate,
  localizePathname,
} from '@/lib/i18n';

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
const posts = await getCollection('blog', ({ data }) => data.draft !== true && data.lang === lang);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={t('PageblogTitle', { site: 'Miles' })}
  description={t('PageBlogDescription')}
>
  <div class="relative min-h-screen isolate overflow-hidden">
    <!-- Background layers -->
    <div class="pointer-events-none absolute inset-0 -z-10 h-full w-full [--ray-c:rgba(14,165,233,0.35)] dark:[--ray-c:rgba(251,191,36,0.15)]">
      <!-- Subtle top-down gradient -->
      <div class="absolute inset-0 bg-linear-to-b from-background via-background/95 to-background opacity-90"></div>
      
      <!-- Subtle animated color blobs for both light and dark modes -->
      <div class="absolute inset-0 opacity-40 mix-blend-soft-light dark:opacity-30 dark:mix-blend-normal">
        <div class="animate-aurora absolute -inset-[20%] bg-[radial-gradient(circle_at_15%_15%,oklch(from_var(--brand)_l_c_h_/_25%)_0%,transparent_50%),radial-gradient(circle_at_85%_10%,oklch(from_var(--brand-secondary)_l_c_h_/_20%)_0%,transparent_50%),radial-gradient(circle_at_50%_80%,oklch(from_var(--brand)_l_c_h_/_15%)_0%,transparent_50%)] blur-3xl dark:bg-[radial-gradient(circle_at_15%_15%,rgba(251,191,36,0.15)_0%,transparent_50%),radial-gradient(circle_at_85%_10%,rgba(245,158,11,0.12)_0%,transparent_50%),radial-gradient(circle_at_50%_80%,rgba(217,119,6,0.1)_0%,transparent_50%)]"></div>
      </div>

      <!-- Light Rays for a more dynamic "lit" feel -->
      <LightRays
        client:load
        count={8}
        speed={12}
        color="var(--ray-c)"
        length="120vh"
        blur={40}
        className="opacity-100 dark:opacity-80"
      />
    </div>

    <main class="container mx-auto px-4 pt-24 pb-16 relative z-10">
      <h1 class="mb-2 text-4xl font-bold tracking-tight text-foreground/90">{t('Headerblog')}</h1>
      <p class="mb-8 max-w-2xl text-muted-foreground">{t('PageBlogDescription')}</p>
      <div class="flex flex-col gap-6">
      {
        sortedPosts.map((post) => (
          <article class="group">
            <a
              href={localizePathname(`/blog/${post.id}`, lang)}
              class="relative block overflow-hidden rounded-lg border border-border p-6 transition-all duration-300 ease-out hover:scale-[0.98]"
            >
              <ShineBorder
                client:load
                className="opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                shineColor={["#A07CFE", "#FE8FB5", "#FFBE7B"]}
              />
              <h2 class="relative z-10 text-xl font-semibold text-foreground group-hover:underline">
                {post.data.title}
              </h2>
              <p class="relative z-10 mt-2 text-muted-foreground">{post.data.description}</p>
              <div class="relative z-10 mt-2 flex flex-col gap-1 text-sm text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
                <time>{formatDate(post.data.pubDate, lang)}</time>
                <span class="hidden sm:inline">|</span>
                <span>{calculateReadTime(post.body || '').text}</span>
              </div>
              {
                post.data.updatedDate && (
                  <div class="relative z-10 mt-1 text-xs text-muted-foreground/70">
                    {t('Labelupdated')}: <time>{formatDate(post.data.updatedDate, lang)}</time>
                  </div>
                )
              }
            </a>
          </article>
        ))
      }
    </div>
  </main>
  </div>
</BaseLayout>
