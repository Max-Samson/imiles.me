---
import PlaygroundDocsLayout from '@/layouts/PlaygroundDocsLayout.astro';
import { ComponentPreview } from '@/components/playground/ComponentPreview';
import { LinkPreview } from '@/components/ui/link-preview';
import { LinkPreviewShowcase } from '@/components/playground/PlaygroundExtraDemos';
import PropsTable, { type PropItem } from '@/components/playground/PropsTable.astro';
import ArchitectureFeatures from '@/components/playground/ArchitectureFeatures.astro';

const codeSnippet = `import { LinkPreview } from '@/components/ui/link-preview';

export function PreviewDemo() {
  return (
    <p className="text-sm text-foreground">
      Explore{' '}
      <LinkPreview
        url="https://imiles.me"
        isStatic={true}
        imageSrc="/assets/demo/ExpandingCarousel-demo1.jpeg"
        width={220}
        height={130}
        className="font-bold text-sky-400 underline"
      >
        Demo Link
      </LinkPreview>
      {' '}with hover preview card.
    </p>
  );
}`;

const propItems: PropItem[] = [
  {
    prop: 'url',
    type: 'string',
    required: true,
    description: '目标预览网址，支持外部互联网链接与站点内部相对路径。',
  },
  {
    prop: 'isStatic',
    type: 'boolean',
    default: 'false',
    description: '是否启用本地静态图片模式，避免生产环境因外部截图接口限流造成白屏。',
  },
  {
    prop: 'imageSrc',
    type: 'string',
    description: '当 isStatic 为 true 时展示的本地静态图片资源路径 (如 /assets/demo/ExpandingCarousel-demo1.jpeg)。',
  },
  {
    prop: 'width / height',
    type: 'number',
    default: '220 / 135',
    description: '悬浮卡片缩略图宽高分辨率像素值。',
  },
  {
    prop: 'triggerAsChild',
    type: 'boolean',
    default: 'false',
    description: '是否使用 Radix Slot 代理子元素作为直接 trigger（如包裹原生 <a> 标签）。',
  },
  {
    prop: 'className',
    type: 'string',
    description: '自定义文本触发器标签的样式类名。',
  },
];

const features = [
  { label: 'Mounting', value: 'Radix Portal to Body', description: '彻底杜绝父容器 overflow-hidden 截断' },
  { label: 'Layering', value: 'Top-Level z-50 Stacking', description: '全局浮层顶层层叠上下文保证' },
  { label: 'Optics', value: '1px Convex Lens Reflection', description: '双层高斯模糊与水银高光玻璃外壳' },
  { label: 'Motion', value: 'Spring Scale 0.92 to 1', description: '带平滑微震物理入场阻尼' },
];
---

<PlaygroundDocsLayout currentId="link-preview">
  {/* 1. Magic UI 主视窗 (Preview / Code / ↻ Replay / 📋 Copy) */}
  <ComponentPreview
    client:load
    code={codeSnippet}
    canvasBackground="dots"
    minHeight="min-h-[340px]"
  >
    <div class="py-4 w-full flex justify-center">
      <LinkPreviewShowcase client:load />
    </div>
  </ComponentPreview>

  {/* 2. 声明式 Props 参数表格 */}
  <PropsTable
    items={propItems}
    color="purple"
    description="基于 Radix UI 与 Motion 打造，兼具极速响应与空间计算折射美感。"
  />

  {/* 3. 底层物理与光学规格 */}
  <ArchitectureFeatures items={features} className="pt-4" />
</PlaygroundDocsLayout>
