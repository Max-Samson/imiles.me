---
import PlaygroundDocsLayout from '@/layouts/PlaygroundDocsLayout.astro';
import { ComponentPreview } from '@/components/playground/ComponentPreview';
import { ExpandingCarouselShowcase } from '@/components/playground/PlaygroundExtraDemos';
import PropsTable, { type PropItem } from '@/components/playground/PropsTable.astro';
import ArchitectureFeatures from '@/components/playground/ArchitectureFeatures.astro';

const codeSnippet = `import ExpandingCarousel, { type ExpandingCarouselItem } from '@/components/ui/expanding-carousel';

export function CarouselDemo() {
  const items: ExpandingCarouselItem[] = [
    {
      id: 'demo-1',
      eyebrow: 'Demo 01',
      title: 'Demo Item 1',
      description: '这里是卡片简单描述占位文本。',
      image: {
        src: '/assets/demo/ExpandingCarousel-demo1.jpeg',
        alt: 'Demo 1',
        fit: 'cover',
      },
      badges: ['React', 'TypeScript'],
      links: [{ label: 'Details', href: '/playground' }],
    },
    {
      id: 'demo-2',
      eyebrow: 'Demo 02',
      title: 'Demo Item 2',
      description: '这里是卡片简单描述占位文本。',
      image: { src: '/assets/demo/ExpandingCarousel-demo2.jpeg', alt: 'Demo 2', fit: 'cover' },
      badges: ['Motion', 'Tailwind'],
      links: [{ label: 'Details', href: '/playground' }],
    },
  ];

  return (
    <ExpandingCarousel
      items={items}
      label="Demo Carousel"
      labels={{
        previous: '上一项',
        next: '下一项',
        pause: '暂停',
        play: '播放',
        slide: '卡片',
      }}
      interval={3500}
    />
  );
}`;

const propItems: PropItem[] = [
  {
    prop: 'items',
    type: 'ExpandingCarouselItem[]',
    required: true,
    description: '卡片项数据源数组。包含 id、title、description、image、badges、links 等。',
  },
  {
    prop: 'label',
    type: 'string',
    required: true,
    description: '轮播组件的可访问性 ARIA 标识文本 (如 "Selected projects")。',
  },
  {
    prop: 'labels',
    type: '{ previous, next, pause, play, slide }',
    required: true,
    description: '国际化无障碍操作按钮文案对象（上一张、下一张、暂停、播放等）。',
  },
  {
    prop: 'interval',
    type: 'number',
    default: '3000',
    description: '自动轮播切换时间间隔（毫秒）。设为 0 时彻底禁用自动轮播。鼠标悬停、焦点进入组件、离开视口或页面隐藏时暂停；减少动态效果偏好下不自动播放。',
  },
  {
    prop: 'initialIndex',
    type: 'number',
    default: '0',
    description: '首次挂载时选中的卡片下标，从 0 开始；超出范围会限制到有效下标。',
  },
  {
    prop: 'renderMedia',
    type: '(item: ExpandingCarouselItem) => ReactNode | undefined',
    description: '用于视频、Canvas 等自定义媒体，自行设置尺寸；保留文字与侧边预览，返回 undefined 时使用 image/terminal。',
  },
  {
    prop: 'renderContent',
    type: '(item, active) => ReactNode',
    description: '替换整个展开内容（包括文字和媒体）；使用后默认媒体区域及 renderMedia 不再渲染。',
  },
  {
    prop: 'renderPreview',
    type: '(item) => ReactNode',
    description: '自定义未展开侧边卡片缩略内容的渲染函数。',
  },
  {
    prop: 'className',
    type: 'string',
    description: '最外层容器查询容器的自定义 CSS 类名合并。',
  },
  {
    prop: 'style',
    type: 'CSSProperties',
    description: '支持传入 --carousel-* 系列 CSS 变量进行尺寸、表面颜色与位移动效定制。',
  },
];

const imageProps: PropItem[] = [
  { prop: 'src', type: 'string', required: true, description: '默认图片地址。未匹配 source 时由 img 的 srcSet / src 选图；加载失败不会自动回退。' },
  { prop: 'alt', type: 'string', required: true, description: '展开图片的替代文本；侧边预览自动使用空 alt，按钮已有可访问名称。' },
  { prop: 'fit', type: "'cover' | 'contain'", default: "'cover'", description: 'cover 铺满并裁切；contain 完整显示，比例不同时留白。无固定图片尺寸要求；侧边预览始终 cover。' },
  { prop: 'sources', type: 'ExpandingCarouselImageSource[]', description: '不同构图或格式的候选来源。选择首个 media 匹配且 type 受支持的项，具体条件应放在前面。' },
  { prop: 'srcSet', type: 'string', description: '默认 img 的分辨率候选，如 /cover-640.webp 640w, /cover-1280.webp 1280w。' },
  { prop: 'sizes', type: 'string', description: '使用 w 描述符时告诉浏览器图片预计显示宽度，不改变 CSS 布局；source 未设置 sizes 时继承此值。' },
  { prop: 'previewSrc', type: 'string', description: '可选的独立静态缩略图。设置后预览忽略 sources、srcSet、sizes；未设置时共享展开图的响应式配置。' },
];

const sourceProps: PropItem[] = [
  { prop: 'srcSet', type: 'string', required: true, description: '单个图片地址，或带 w / x 描述符的候选列表。' },
  { prop: 'media', type: 'string', description: '原生视口媒体查询，如 (max-width: 599px)。省略时不限制视口，通常放在数组末尾。' },
  { prop: 'type', type: 'string', description: '可选 MIME 类型，如 image/avif、image/webp，浏览器跳过不支持的格式。' },
  { prop: 'sizes', type: 'string', default: 'image.sizes', description: '当前来源的预计显示宽度，覆盖图片级 sizes。' },
];

const responsiveSnippet = `import type { ExpandingCarouselImage } from '@/components/ui/expanding-carousel';

const image: ExpandingCarouselImage = {
  src: '/projects/mtimer/mtimer-cover-zh.jpeg',
  alt: 'MTimer 番茄钟项目展示',
  fit: 'cover',
  sources: [
    {
      media: '(max-width: 599px)',
      srcSet: '/projects/mtimer/mtimer-cover-ph-zh.webp',
      type: 'image/webp',
    },
  ],
};`;

const resolutionSnippet = `// 素材路径为示意，请先提供同一构图的对应分辨率文件。
const image = {
  src: '/images/cover-1280.webp',
  alt: '产品展示',
  srcSet: '/images/cover-640.webp 640w, /images/cover-1280.webp 1280w',
  // 示例值，需根据宿主页面中图片实际显示宽度调整。
  sizes: '(max-width: 599px) 296px, 320px',
};`;

const features = [
  { label: 'Geometry', value: '3-Tier Connected Cards', description: '中央展开卡与两侧折叠缩略卡' },
  { label: 'Connectors', value: 'Dynamic SVG Bridging', description: '实时测量外露边缘并生成无缝接缝' },
  { label: 'Indicators', value: '8px to 80px Progress Bar', description: '底部进度条随轮播自动拉伸' },
  { label: 'Responsive', value: 'CSS Container Queries', description: '@container 自适应任意父容器宽度' },
];
---

<PlaygroundDocsLayout currentId="expanding-carousel">
  <ComponentPreview
    client:load
    code={codeSnippet}
    canvasBackground="dots"
    minHeight="min-h-[640px]"
    contentPadding="px-2 sm:px-4 py-8"
  >
    <div class="w-full">
      <ExpandingCarouselShowcase client:load />
    </div>
  </ComponentPreview>

  <PropsTable items={propItems} />

  <PropsTable title="图片配置 · ExpandingCarouselImage" items={imageProps} description="配置在 items 中的 image 字段。普通图片只需要 src 与 alt。" />
  <PropsTable title="图片来源 · ExpandingCarouselImageSource" items={sourceProps} description="sources 数组的每一项对应原生 picture 中的一个 source。" />

  <section class="space-y-4 text-sm text-muted-foreground leading-relaxed" aria-labelledby="carousel-responsive">
    <h2 id="carousel-responsive" class="text-xl font-bold text-foreground">移动端与桌面端使用不同构图</h2>
    <p>将下面的 image 放入卡片条目。图片断点由调用方指定，基于视口宽度；轮播布局基于容器宽度，缩小容器不会触发视口选图。</p>
    <pre class="not-prose overflow-x-auto rounded-xl border border-border/70 bg-neutral-950 p-5 text-xs leading-relaxed text-sky-300"><code>{responsiveSnippet}</code></pre>
    <h3 class="text-lg font-semibold text-foreground">同一构图使用不同分辨率</h3>
    <pre class="not-prose overflow-x-auto rounded-xl border border-border/70 bg-neutral-950 p-5 text-xs leading-relaxed text-sky-300"><code>{resolutionSnippet}</code></pre>
  </section>

  <section class="space-y-4 text-sm text-muted-foreground leading-relaxed" aria-labelledby="carousel-usage">
    <h2 id="carousel-usage" class="text-xl font-bold text-foreground">接入提示</h2>
    <ul class="list-disc pl-5 space-y-3">
      <li>Astro 中将示例封装为 React 组件，以 <code>&lt;CarouselDemo client:visible /&gt;</code> 水合；自定义渲染函数定义在 React 内部。</li>
      <li>嵌入带 <code>prose</code> 的正文时，外包 <code>not-prose</code>，避免正文样式影响图片与排版。<code>ComponentPreview</code> 已内置隔离。</li>
      <li>跨项目复用需同时携带 TSX 与 CSS，适配 <code>cn</code>、主题变量，并提供 React、lucide-react 依赖。</li>
    </ul>
  </section>

  <ArchitectureFeatures items={features} className="pt-4" />
</PlaygroundDocsLayout>
