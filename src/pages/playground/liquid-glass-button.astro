---
import PlaygroundDocsLayout from '@/layouts/PlaygroundDocsLayout.astro';
import { ComponentPreview } from '@/components/playground/ComponentPreview';
import { LiquidGlassHeroPreview } from '@/components/playground/PlaygroundExtraDemos';
import PropsTable, { type PropItem } from '@/components/playground/PropsTable.astro';
import ArchitectureFeatures, { type ArchitectureFeatureItem } from '@/components/playground/ArchitectureFeatures.astro';
import LiquidGlassButtonDemo from '@/components/playground/LiquidGlassButtonDemo';

const heroCode = `import { LiquidGlassButton } from '@/components/ui/liquid-glass-button';
import { Sparkles, ArrowRight } from 'lucide-react';

export function ButtonDemo() {
  return (
    <div className="flex flex-wrap items-center justify-center gap-4">
      <LiquidGlassButton
        variant="brand"
        size="default"
        shape="pill"
        glow
        icon={<Sparkles className="size-4" />}
      >
        Liquid Glass
      </LiquidGlassButton>

      <LiquidGlassButton
        variant="blue"
        size="default"
        shape="pill"
        glow
        iconRight={<ArrowRight className="size-4" />}
      >
        VisionOS Azure
      </LiquidGlassButton>

      <LiquidGlassButton
        variant="rainbow"
        size="default"
        shape="pill"
        shimmer
        glow
      >
        Apple Intelligence
      </LiquidGlassButton>
    </div>
  );
}`;

const propItems: PropItem[] = [
  {
    prop: 'variant',
    type: "'default' | 'frosted' | 'brand' | 'accent' | 'blue' | 'purple' | 'obsidian' | 'rainbow' | 'destructive' | 'ghost'",
    default: "'default'",
    description: '拟物玻璃材质与颜色变体风格（含水晶透明、浓郁磨砂、品牌流金、翡翠灵动、电光蔚蓝、熏黑曜石及虹彩流光等）。',
  },
  {
    prop: 'size',
    type: "'xs' | 'sm' | 'default' | 'lg' | 'xl' | 'icon-sm' | 'icon' | 'icon-lg'",
    default: "'default'",
    description: '按钮尺寸规范（包含正方形/圆形图标按钮专用尺寸）。',
  },
  {
    prop: 'shape',
    type: "'pill' | 'squircle' | 'rounded'",
    default: "'pill'",
    description: '外形轮廓：胶囊圆角（rounded-full）、iOS平滑方圆（rounded-2xl）或适度圆角（rounded-xl）。',
  },
  {
    prop: 'interactive',
    type: 'boolean',
    default: 'true',
    description: '是否开启光标动态折射镜面高光 (Fresnel 聚光反光)。滑动鼠标时呈现逼真凸面镜反光流动。',
  },
  {
    prop: 'shimmer',
    type: 'boolean',
    default: 'false',
    description: '是否开启持续微光液态流动折射波纹（营造活体流动感）。',
  },
  {
    prop: 'curvedBevel',
    type: 'boolean',
    default: 'true',
    description: '是否显示顶部 1px 凸面透镜倒角镜面高光反射线与底部弱折射光。',
  },
  {
    prop: 'glow',
    type: 'boolean',
    default: 'false',
    description: '是否开启背后彩色环境柔和光晕 (Ambient Aura)，匹配材质色调。',
  },
  {
    prop: 'glowColor',
    type: 'string',
    description: '自定义环境漫射光晕背景颜色 (CSS color / gradient)。',
  },
  {
    prop: 'hapticScale',
    type: 'boolean',
    default: 'true',
    description: '是否开启弹性微物理悬停浮起 (scale: 1.025) 与按压阻尼动画 (scale: 0.965)。',
  },
  {
    prop: 'href',
    type: 'string',
    description: '传入超链接时自动渲染为无障碍链接标签 <a>，未传时渲染为 <button>。',
  },
  {
    prop: 'icon / iconRight',
    type: 'React.ReactNode',
    description: '前置或后置图标元素插槽。',
  },
  {
    prop: 'loading',
    type: 'boolean',
    default: 'false',
    description: '加载中状态，呈现平滑旋转的液态加载动画。',
  },
  {
    prop: 'disabled',
    type: 'boolean',
    default: 'false',
    description: '禁用状态，半透明降低对比度并锁死交互。',
  },
];

const features: ArchitectureFeatureItem[] = [
  { label: 'Optics', value: '24px Blur + 180% Saturate', description: 'VisionOS 高斯模糊双层微折射' },
  { label: 'Highlight', value: '1px Convex Curved Bevel', description: '顶部弧面透镜镜面倒角高光' },
  { label: 'Dynamics', value: 'Fresnel Spotlight + Shimmer', description: '光标聚光漫射与持续液态流光' },
  { label: 'Variants', value: '10 Styles & 8 Sizes', description: '包含 Apple Intelligence 虹彩流光' },
];
---

<PlaygroundDocsLayout currentId="liquid-glass-button">
  {/* 1. Magic UI 主视窗 (Preview / Code / ↻ Replay / 📋 Copy) */}
  <ComponentPreview
    client:load
    code={heroCode}
    canvasBackground="dots"
    minHeight="min-h-[360px]"
  >
    <LiquidGlassHeroPreview client:load />
  </ComponentPreview>

  {/* 2. 声明式 Props 参数表格 (Astro 结构化驱动，零 HTML 样板代码) */}
  <PropsTable
    items={propItems}
    description="支持通过 class-variance-authority 变体扩展与原生 HTML/Motion 属性无缝透传。"
  />

  {/* 3. 完整交互沙盒与调参台 */}
  <section class="space-y-4 pt-4">
    <div class="border-b border-border/60 pb-3">
      <h2 class="text-xl font-bold tracking-tight text-foreground flex items-center gap-2">
        <span class="text-sky-400">🎛</span>
        <span>Interactive Sandbox</span>
      </h2>
      <p class="text-xs text-muted-foreground mt-1 leading-relaxed">
        实时切换材质变体、形态与物理特性的完整调参台。
      </p>
    </div>
    <LiquidGlassButtonDemo client:load />
  </section>

  {/* 4. 底层物理与光学规格 */}
  <ArchitectureFeatures items={features} className="pt-4" />
</PlaygroundDocsLayout>
