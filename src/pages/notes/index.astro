---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NoteCard from '@/components/note/NoteCard';
import { research as notes } from '@/data/notes';
import ContentFlickeringBackground from '@/components/layout/ContentFlickeringBackground';
import { getLocaleFromPathname } from '@/lib/i18n';
import { useTranslations } from '@/lib/i18n';
const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
---

<BaseLayout
  title={t('PageDailyTitle', { site: 'Miles' })}
  description={t('PageNotesDescription')}
>
  <div class="relative min-h-screen isolate overflow-hidden">
    <ContentFlickeringBackground client:only="react" />

    <main class="container mx-auto px-4 pt-24 pb-16 relative z-10">
      <h1 class="mb-2 text-4xl font-bold tracking-tight text-foreground/90">{t('NoteTitle')}</h1>
      <p class="mb-10 max-w-2xl text-muted-foreground">{t('PageNotesDescription')}</p>

      <div class="grid gap-6 ">
        {notes.map((item, i) => (
          <NoteCard item={item} index={i} lang={lang} client:visible />
        ))}
      </div>
    </main>
  </div>
</BaseLayout>
