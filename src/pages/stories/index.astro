---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { calculateReadTime } from '@/lib/readTime';
import ContentFlickeringBackground from '@/components/layout/ContentFlickeringBackground';
import { ShineBorder } from '@/registry/magicui/shine-border';
import {
  useTranslations,
  getLocaleFromPathname,
  formatDate,
} from '@/lib/i18n';
import { getPublicContentEntries } from '@/server/content/public-index';

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);

const sortedStories = await getPublicContentEntries(Astro.locals, 'stories', lang);

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=1800',
);
---

<BaseLayout title={t('PagestoriesTitle', { site: 'Miles' })} description={t('PageStoriesDescription')}>
  <div class="relative min-h-screen isolate overflow-hidden">
    <ContentFlickeringBackground client:idle />

    <main class="container mx-auto px-4 pt-24 pb-16 relative z-10">
      <h1 class="mb-2 text-4xl font-bold tracking-tight text-foreground/90">{t('Headerstories')}</h1>
      <p class="mb-8 max-w-2xl text-muted-foreground">{t('PageStoriesDescription')}</p>
      <div class="flex flex-col gap-6">
        {
          sortedStories.map((story) => (
            <article class="group relative overflow-hidden rounded-lg border border-border bg-white/5 dark:bg-black/5 backdrop-blur-md p-6 transition-all duration-300 ease-out hover:scale-[0.98] hover:border-primary/50">
              <ShineBorder
                client:visible={{ rootMargin: '200px' }}
                className="rounded-lg opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                shineColor={['#A07CFE', '#FE8FB5', '#FFBE7B']}
              />
              <div class="relative z-10 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <a href={story.publicPath} class="block min-w-0 flex-1">
                  <h2 class="text-xl font-semibold text-foreground group-hover:underline">
                    {story.title}
                  </h2>
                  <p class="mt-2 text-muted-foreground">{story.description}</p>
                  <div class="mt-2 flex flex-col gap-1 text-sm text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
                    <time>{formatDate(story.pubDate, lang)}</time>
                    <span class="hidden sm:inline">|</span>
                    <span>{calculateReadTime(story.body).text}</span>
                  </div>
                  {
                    story.updatedDate && (
                      <div class="mt-1 text-xs text-muted-foreground/70">
                        {t('Labelupdated')}: <time>{formatDate(story.updatedDate, lang)}</time>
                      </div>
                    )
                  }
                  {story.tags.length > 0 && (
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                      {story.tags.map((tag) => (
                        <span class="text-sm text-muted-foreground">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </main>
  </div>
</BaseLayout>
