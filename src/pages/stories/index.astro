---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { calculateReadTime } from '@/lib/readTime';
import { resolveContentPublicPath } from '@/lib/content-routing';
import ContentFlickeringBackground from '@/components/layout/ContentFlickeringBackground';
import { ShineBorder } from '@/registry/magicui/shine-border';
import {
  useTranslations,
  getLocaleFromPathname,
  formatDate,
} from '@/lib/i18n';
import { getServerEnv } from '@/server/env';
import { contentReadRepository } from '@/server/content/read-repository';
import { normalizeTags } from '@/lib/tags';

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);

const storiesMap = new Map<
  string,
  {
    id: string;
    data: {
      title: string;
      description?: string | null;
      pubDate: Date;
      updatedDate?: Date | null;
      tags: string[];
    };
    body?: string;
    publicPath?: string;
  }
>();

try {
  const staticStories = await getCollection('stories', ({ data }) => data.lang === lang);
  for (const s of staticStories) {
    const publicPath = resolveContentPublicPath('stories', lang, s.id);
    storiesMap.set(publicPath, {
      id: s.id,
      data: s.data,
      body: s.body,
      publicPath,
    });
  }
} catch {
  // 静态集合容错
}

try {
  const env = getServerEnv(Astro.locals);
  const dbStories = await contentReadRepository(env).listPublished('stories', lang);
  for (const p of dbStories) {
    storiesMap.set(p.publicPath, {
      id: p.slug,
      data: {
        title: p.title,
        description: p.description,
        pubDate: new Date(p.pubDate),
        updatedDate: p.updatedDate ? new Date(p.updatedDate) : null,
        tags: (() => {
          try {
            return JSON.parse(p.tags);
          } catch {
            return [];
          }
        })(),
      },
      body: p.contentRaw,
      publicPath: p.publicPath,
    });
  }
} catch {
  // DB fallback
}

const sortedStories = Array.from(storiesMap.values()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={t('PagestoriesTitle', { site: 'Miles' })} description={t('PageStoriesDescription')}>
  <div class="relative min-h-screen isolate overflow-hidden">
    <ContentFlickeringBackground client:only="react" />

    <main class="container mx-auto px-4 pt-24 pb-16 relative z-10">
      <h1 class="mb-2 text-4xl font-bold tracking-tight text-foreground/90">{t('Headerstories')}</h1>
      <p class="mb-8 max-w-2xl text-muted-foreground">{t('PageStoriesDescription')}</p>
      <div class="flex flex-col gap-6">
        {
          sortedStories.map((story) => (
            <article class="group relative overflow-hidden rounded-lg border border-border bg-white/5 dark:bg-black/5 backdrop-blur-md p-6 transition-all duration-300 ease-out hover:scale-[0.98] hover:border-primary/50">
              <ShineBorder
                client:load
                className="rounded-lg opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                shineColor={['#A07CFE', '#FE8FB5', '#FFBE7B']}
              />
              <div class="relative z-10 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <a
                  href={story.publicPath || resolveContentPublicPath('stories', lang, story.id)}
                  class="block min-w-0 flex-1"
                >
                  <h2 class="text-xl font-semibold text-foreground group-hover:underline">
                    {story.data.title}
                  </h2>
                  <p class="mt-2 text-muted-foreground">{story.data.description}</p>
                  <div class="mt-2 flex flex-col gap-1 text-sm text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
                    <time>{formatDate(story.data.pubDate, lang)}</time>
                    <span class="hidden sm:inline">|</span>
                    <span>{calculateReadTime(story.body || '').text}</span>
                  </div>
                  {
                    story.data.updatedDate && (
                      <div class="mt-1 text-xs text-muted-foreground/70">
                        {t('Labelupdated')}: <time>{formatDate(story.data.updatedDate, lang)}</time>
                      </div>
                    )
                  }
                  {normalizeTags(story.data.tags).length > 0 && (
                    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                      {normalizeTags(story.data.tags).map((tag) => (
                        <span class="text-sm text-muted-foreground">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </main>
  </div>
</BaseLayout>
