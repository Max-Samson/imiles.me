---
import ShareButton from '@/components/articlebtn/ShareButton';
import CopyMarkdownButton from '@/components/articlebtn/CopyMarkdownButton';
import { formatDate, getLocaleFromPathname, useTranslations } from '@/lib/i18n';
import type { PostFrontmatter } from '@/lib/mdxToMarkdown';

interface Props {
  title: string;
  pubDate: Date;
  updatedDate?: Date;
  readTime: string;
  tags?: string[];
  shareUrl: string;
  shareText?: string;
  body: string;
  frontmatter: PostFrontmatter;
  slug: string;
  proseClass?: string;
}

const {
  title,
  pubDate,
  updatedDate,
  readTime,
  tags = [],
  shareUrl,
  shareText,
  body,
  frontmatter,
  slug,
  proseClass,
} = Astro.props as Props;

const lang = getLocaleFromPathname(Astro.url.pathname);
const { t } = useTranslations(lang);
---

<article class="mx-auto max-w-3xl px-6 pt-24 pb-16">
  <header class="mb-8">
    <h1 class="text-4xl font-bold">{title}</h1>
    <div class="mt-4 flex items-center gap-2">
      <CopyMarkdownButton
        client:load
        postBody={body}
        postFrontmatter={frontmatter}
        slug={slug}
      />
      <ShareButton
        client:load
        url={shareUrl}
        title={title}
        description={frontmatter.description}
        shareText={shareText}
      />
    </div>
    <div class="mt-4 flex flex-col gap-1 text-muted-foreground sm:flex-row sm:items-center sm:gap-2">
      <time>{formatDate(pubDate, lang)}</time>
      <span class="hidden sm:inline">|</span>
      <span>{readTime}</span>
    </div>
    {
      updatedDate && (
        <div class="mt-1 text-sm text-muted-foreground/70">
          {t('Labelupdated')}: <time>{formatDate(updatedDate, lang)}</time>
        </div>
      )
    }
    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
        {tags.map((tag) => (
          <span class="text-sm text-muted-foreground">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </header>

  <slot name="before-content" />

  <div class:list={['prose prose-neutral dark:prose-invert max-w-none', proseClass]}>
    <slot />
  </div>

  <slot name="after-content" />
</article>

<slot name="enhancers" />
