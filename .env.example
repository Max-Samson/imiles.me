# ==============================================================================
# imiles.me — 环境变量配置模板 (.env.example)
# 复制此文件为 .env 并填入对应的值：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础运行环境与站点地址
# ------------------------------------------------------------------------------
# 运行环境模式：development | staging | production
ENVIRONMENT="development"

# 站点访问地址（末尾请勿带斜杠 /）
# 本地开发填 http://localhost:4321；生产环境填 https://imiles.me
SITE_URL="http://localhost:4321"

# 内部加密与签名密钥（至少 32 字节随机字符串）
APP_SECRET="your-32-byte-random-secret-key-goes-here"

# ------------------------------------------------------------------------------
# 2. CMS GitHub 内容仓库配置（本地调试与生产隔离防混淆）
# ------------------------------------------------------------------------------
# 目标 GitHub 仓库，格式为 "owner/repo"
CMS_GITHUB_REPO="Max-Samson/imiles.me"

# 目标代码分支（本地调试绑定 dev-content，生产绑定 master）：
# - 【本地开发调试】：固定绑定到 "dev-content" 分支。
#   * 本地如果需要向 Git 提交，统一推送到 dev-content 分支。
#   * GitHub Actions 部署流水线（.github/workflows/deploy.yml）仅监听 master/main 分支，
#     因此向 dev-content 分支提交绝不会触发生产自动化构建上线，彻底防止调试内容混入线上。
# - 【线上生产环境】：固定绑定为 "master"（通过 Cloudflare 部署环境变量注入，发布自动触发上线）。
# - 【只读快照模式】：本地若未配置 CMS_GITHUB_TOKEN，CMS 自动运行在快照只读模式，
#   所有编辑仅暂存在本地 D1 数据库工作草稿中，绝不推送到远程 Git 仓库。
CMS_GITHUB_BRANCH="dev-content"

# GitHub Personal Access Token (PAT)
# 需要目标仓库的 contents:read 和 contents:write 权限（Fine-grained 或 Classic PAT）。
# 本地不填写时，系统自动降级为本地快照只读模式，保护远程仓库安全。
CMS_GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Cloudflare Zero Trust Access 后台身份校验
# ------------------------------------------------------------------------------
# 在本地开发环境（ENVIRONMENT="development" 且访问 localhost/127.0.0.1）时，
# 系统自动进入 local-development 模式，无需配置 Access 证书。
# 线上生产环境必填：
ACCESS_ISSUER="https://your-team.cloudflareaccess.com"
ACCESS_AUD="your-cloudflare-access-application-audience-tag"
ADMIN_EMAILS="admin@example.com"

# 自动化/Service Token 权限配置（可选）
ADMIN_SERVICE_TOKEN_IDS=""
ADMIN_SERVICE_TOKEN_CAPABILITIES=""

# ------------------------------------------------------------------------------
# 4. Cloudflare D1 关系型数据库与 KV 键值缓存
# ------------------------------------------------------------------------------
# D1 数据库标识
CLOUDFLARE_D1_DATABASE_NAME="BLOG-DB"
CLOUDFLARE_D1_DATABASE_ID=""

# 业务 KV 缓存标识
CLOUDFLARE_KV_NAMESPACE_NAME="BOLG-KV"
CLOUDFLARE_KV_NAMESPACE_ID=""

# Astro Session KV 标识
CLOUDFLARE_SESSION_KV_NAMESPACE_NAME="imiles-session"
CLOUDFLARE_SESSION_KV_NAMESPACE_ID=""

# ------------------------------------------------------------------------------
# 5. Cloudflare Turnstile 人机验证
# ------------------------------------------------------------------------------
# 本地开发测试可使用官方测试 Key：
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
CLOUDFLARE_TURNSTILE_WIDGET_NAME="imiles-friend-link-application"

# 友链表单提交限流 HMAC 密钥
SUBMISSION_HMAC_SECRET="your-submission-hmac-secret-string"

# ------------------------------------------------------------------------------
# 6. Supabase S3 兼容对象存储（用于媒体图片与草稿资产）
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_REF=""
SUPABASE_S3_REGION="ap-southeast-1"
SUPABASE_STORAGE_BUCKET="blog-bucket"
CMS_DRAFT_STORAGE_BUCKET="cms-draft-assets"
SUPABASE_S3_ENDPOINT=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 7. 邮件服务配置 (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="noreply@imiles.me"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
