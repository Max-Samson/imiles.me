{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler", ".pnpm-store"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pageel/plugin-mdx": ["./packages/pageel-workbench/plugin-mdx/index.ts"],
      "@pageel/plugin-types": ["./packages/pageel-workbench/plugin-types/index.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true
  }
}
